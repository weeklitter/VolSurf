# ═══════════════════════════════════════════════════════════════════════════
# VolSurf 环境变量模板（仓库根目录）
# 复制为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════════════════════

# ── Tushare ──
TUSHARE_TOKEN=your_tushare_token_here

# ── PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=volsurf
DB_USER=volsurf
DB_PASSWORD=your_password_here

# ── .NET API ──
INTERNAL_KEY=generate_a_random_key_here
SERILOG_MIN_LEVEL=Information
RISK_FREE_RATE=0.02
CORS_ORIGIN=https://volsurf.yourdomain.com

# ── Python data-fetcher ──
API_BASE_URL=http://api:5000
LOG_LEVEL=INFO

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_BASE_URL=https://volsurf.yourdomain.com/api