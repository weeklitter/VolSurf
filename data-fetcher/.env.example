# ═══════════════════════════════════════════════════════════════════════════
# data-fetcher 环境变量模板
# 复制为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════════════════════

# ── Tushare ──
TUSHARE_TOKEN=your_tushare_token_here

# ── PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=volsurf
DB_USER=volsurf
DB_PASSWORD=your_password_here

# ── .NET API ──
API_BASE_URL=http://api:5000
INTERNAL_KEY=generate_a_random_key_here

# ── 日志级别 ──
LOG_LEVEL=INFO